HloModule jit_model, entry_computation_layout={(f32[512,128]{1,0}, f32[128,128]{1,0}, f32[128,128]{1,0}, f32[128,128]{1,0}, f32[128,512]{1,0}, /*index=5*/f32[128,512]{1,0}, f32[512,128]{1,0})->f32[512,128]{1,0}}

silu.1 {
  Arg_0.1 = f32[512,512]{1,0} parameter(0)
  constant.1 = f32[] constant(1)
  broadcast.1 = f32[512,512]{1,0} broadcast(constant.1), dimensions={}
  neg.1 = f32[512,512]{1,0} negate(Arg_0.1)
  exp.1 = f32[512,512]{1,0} exponential(neg.1)
  add.1 = f32[512,512]{1,0} add(exp.1, broadcast.1)
  div.1 = f32[512,512]{1,0} divide(broadcast.1, add.1)
  ROOT mul.1 = f32[512,512]{1,0} multiply(Arg_0.1, div.1)
}

ENTRY main.2 {
