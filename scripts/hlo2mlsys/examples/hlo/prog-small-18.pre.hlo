  w6.1 = f32[512,128]{1,0} parameter(6)
  dot_general.11 = f32[512,128]{1,0} dot(mul.3, w6.1), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  add.4 = f32[512,128]{1,0} add(x0.1, dot_general.11)
  w1.1 = f32[128,128]{1,0} parameter(1)
  dot_general.6 = f32[512,128]{1,0} dot(x0.1, w1.1), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  w2.1 = f32[128,128]{1,0} parameter(2)
