HloModule jit_model, entry_computation_layout={(f32[1024,128]{1,0}, f32[128,1024]{1,0}, f32[1024]{0}, f32[1024,128]{1,0}, f32[128,128]{1,0}, /*index=5*/f32[128,128]{1,0}, f32[128,128]{1,0}, f32[128,512]{1,0}, f32[512]{0}, f32[512,128]{1,0})->f32[1024,128]{1,0}}

silu.1 {
